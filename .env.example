# Copy values into .env.local (never commit real secrets)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Super admin seed — password for npm run seed:admin
# Email/name defaults live in supabase/seed-admin.config.js (override here if needed)
SEED_ADMIN_PASSWORD=change-me-to-a-strong-password
# SEED_ADMIN_EMAIL=admin@newmapeibplateau.org
# SEED_ADMIN_NAME=Super Admin
